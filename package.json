{
  "name": "magpie-provider-eaichat",
  "version": "1.2.0",
  "description": "云智助手（eaichat.ctyun.cn）Token 中心接入 magpie：账号密码登录、自动续登、每日签到、用量显示与模型转发",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "test": "node --test --experimental-strip-types --no-warnings tests/*.test.ts",
    "check": "tsc --noEmit",
    "update:models": "node --experimental-strip-types --no-warnings scripts/update-model-metadata.ts"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "eaichat",
    "ctyun",
    "云智助手",
    "provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4x25/magpie-provider-eaichat.git"
  },
  "license": "MIT",
  "magpie": {
    "name": "云智助手 EAIChat",
    "icon": "https://eaichat.ctyun.cn/chat/favicon.ico",
    "summary": {
      "zh": "云智助手（天翼云）Token 中心：账号密码登录、自动续登、每日签到送 Token、用量显示与模型转发。",
      "en": "EAIChat (CTYun) Token Center: account sign-in with auto-renewal, daily check-in, usage display and model relay."
    },
    "maxConcurrency": 1
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  }
}
